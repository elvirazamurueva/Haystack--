# ============================================
# VPg05 — Диалоговый Telegram-бот
# с долговременной векторной памятью Pinecone
# ============================================
# Скопируйте этот файл в .env и заполните значения.
# НЕ коммитьте .env в систему контроля версий!

# ---- GenAPI (чат и эмбеддинги) ----
GENAPI_API_KEY=your_genapi_key_here

# URL и модель для чата
GENAPI_URL=https://proxy.gen-api.ru/v1/chat/completions
MODEL_ID=gpt-4o-mini

# URL и модель для эмбеддингов
GENAPI_EMBEDDINGS_URL=https://api.gen-api.ru/api/v1/networks/embeddings
EMBEDDING_MODEL=text-embedding-3-small

# ---- Pinecone ----
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=your_index_name_here

# Необязательный прокси только для Pinecone
PINECONE_PROXY_URL=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Необязательный прокси для Telegram (формат: user:password@host:port)
PROXY_URL=

# ---- Таймауты (секунды) ----
TIMEOUT_GENAPI=30
TIMEOUT_PINECONE=30

# ---- Порог дедупликации (0.0–1.0, чем выше — строже) ----
SIMILARITY_THRESHOLD=0.5

# ============================================
# Haystack-ассистент (пакет hay/)
# Все параметры необязательны — ниже значения по умолчанию.
# ============================================

# Размерность эмбеддингов (должна совпадать с размерностью индекса Pinecone)
EMBEDDING_DIM=1536

# Модели: чат и vision (для описания породы на фото)
HAY_CHAT_MODEL=gpt-4o-mini
HAY_VISION_MODEL=gpt-4o-mini

# Базовый URL OpenAI-совместимого API (без /chat/completions).
# Если не задан — выводится автоматически из GENAPI_URL.
# HAY_GENAPI_BASE_URL=https://proxy.gen-api.ru/v1

# Pinecone для ассистента
HAY_PINECONE_NAMESPACE=hay-assistant
HAY_PINECONE_METRIC=cosine
HAY_PINECONE_CLOUD=aws
HAY_PINECONE_REGION=us-east-1

# Поиск по памяти
HAY_TOP_K=5
HAY_MIN_SCORE=0.2

# Поведение агента
HAY_MAX_AGENT_STEPS=6
HAY_HISTORY_LIMIT=12
HAY_TIMEOUT=30
